# audio
audio.service.client_wait_ms=10000
audio.sys.noisy.broadcast.delay=500
audio.sys.mute.latency.factor=2
audio.sys.routing.latency=0
audio.offload.min.duration.secs=30
audio.sys.offload.pstimeout.secs=3

# Cached app compaction
persist.device_config.activity_manager.use_compaction=true

# Dalvik
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.dex2oat-cpu-set=4,5,6,7
dalvik.vm.dex2oat-threads=4
dalvik.vm.image-dex2oat-cpu-set=4,5,6,7
dalvik.vm.image-dex2oat-threads=4

# DEX
pm.dexopt.install=space-profile
pm.dexopt.install-bulk=space-profile
pm.dexopt.bg-dexopt=space-profile
pm.dexopt.ab-ota=space-profile
pm.dexopt.shared=space
